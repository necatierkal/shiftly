# Shiftly Configuration
PROJECT_NAME="Shiftly"
APP_TAGLINE="Vardiyan. Takvimin. Ekibin."
API_V1_STR="/api/v1"

# Security
SECRET_KEY="shiftly-super-secret-production-key-change-in-production-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# Database (Default development: SQLite, Production: PostgreSQL)
DATABASE_URL="sqlite:///./shiftly.db"
# DATABASE_URL="postgresql+psycopg2://shiftly:password@localhost:5432/shiftly_db"

# CORS
BACKEND_CORS_ORIGINS=["*"]

# Demo & Environment
ENVIRONMENT="development"
DEMO_USER_ENABLED=true
